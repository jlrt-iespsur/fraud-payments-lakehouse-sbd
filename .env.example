# Demo-only defaults. Do not use these credentials outside local environments.

# PostgreSQL
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse
POSTGRES_DB=platform
POSTGRES_PORT=5432

# MinIO / S3-compatible storage
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_BUCKET=lakehouse
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_PATH_STYLE_ACCESS=true
SILVER_S3_PATH=s3a://lakehouse/warehouse/payments/silver_payments/data

# MySQL / RDS (Parte9)
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
MYSQL_JDBC_URL=jdbc:mysql://mysql:3306/fraud?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USER=admin
MYSQL_PASSWORD=admin
MYSQL_DATABASE=fraud
MYSQL_TARGET_TABLE=silver_features
MYSQL_WRITE_MODE=append

# Parte10 (Union S3 + RDS)
PARTE10_S3_INPUT_PATH=s3a://lakehouse/warehouse/payments/silver_payments/data
PARTE10_MYSQL_JDBC_URL=jdbc:mysql://mysql:3306/fraud?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
PARTE10_MYSQL_USER=admin
PARTE10_MYSQL_PASSWORD=admin
PARTE10_MYSQL_DATABASE=fraud
PARTE10_MYSQL_TABLE=silver_features
PARTE10_OUTPUT_PATH=s3a://lakehouse/analytics/parte10/high_risk_payments
PARTE10_OUTPUT_MODE=overwrite
PARTE10_HIGH_RISK_THRESHOLD=60
PARTE10_TX5M_THRESHOLD=5
PARTE10_MERCHANTS10M_THRESHOLD=4
PARTE10_COUNTRIES1H_THRESHOLD=3
PARTE10_SUSPICIOUS_COUNTRIES=RU,NG,KP,IR

# Parte12 (Fine-tuning Hugging Face)
PARTE12_MODEL_NAME=prajjwal1/bert-tiny
PARTE12_OUTPUT_DIR=runtime/models/parte12-fraud-hf
PARTE12_EPOCHS=2
PARTE12_BATCH_SIZE=16
PARTE12_LEARNING_RATE=2e-5
PARTE12_HUB_MODEL_ID=
HF_TOKEN=

# Parte11 (Consultas/analisis sobre salida Parte10)
PARTE11_INPUT_PATH=s3a://lakehouse/analytics/parte10/high_risk_payments
PARTE11_OUTPUT_PATH=s3a://lakehouse/analytics/parte11/results
PARTE11_OUTPUT_FORMAT=parquet
PARTE11_OUTPUT_MODE=overwrite
PARTE11_HIGH_RISK_THRESHOLD=70
PARTE11_MIN_HIGH_RISK_TX=2
PARTE11_TX5M_THRESHOLD=8
PARTE11_COUNTRIES_THRESHOLD=2
PARTE11_GEO_COUNTRIES1H_THRESHOLD=2
PARTE11_SUSPICIOUS_COUNTRIES=RU,NG,KP,IR
PARTE11_COMPUTE_COUNTS=false
PARTE11_SHUFFLE_PARTITIONS=8

# Kafka
KAFKA_TOPIC=payments
KAFKA_EXTERNAL_PORT=29092
KAFKA_UI_PORT=8082

# Spark
SPARK_UI_PORT_START=4040
SPARK_UI_PORT_END=4050

# Query and BI
TRINO_PORT=8080
SUPERSET_PORT=8088
AIRFLOW_PORT=8081

# Superset
SUPERSET_SECRET_KEY=fraud-superset-secret
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_PASSWORD=admin

# Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_PASSWORD=admin

# Neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
